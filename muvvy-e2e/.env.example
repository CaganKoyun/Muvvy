# ── Muvvy E2E configuration ────────────────────────────────────────────────
# Copy to `.env` and fill in. Playwright reads these via playwright.config.ts.

# Where the app under test lives.
#   Live prod:   https://muvvy.now
#   Local dev:   http://localhost:8080   (Vite default for Muvvy; adjust if different)
BASE_URL=https://muvvy.now

# Run mode:
#   live  → hits a real backend (Supabase). Needs real test accounts below.
#   mock  → intercepts Supabase REST/Edge calls with fixtures; no backend/creds needed.
#           (Realtime WebSocket flows — live chat push, co-watch inbox push — cannot be
#            truly exercised in mock mode; those specs assert optimistic/REST behavior only.)
E2E_MODE=live

# ── Test accounts (LIVE mode only) ─────────────────────────────────────────
# Use throwaway accounts you own. Two are required for messages + co-watch
# (they need a real friendship between two users).
E2E_EMAIL=
E2E_PASSWORD=
E2E_USERNAME=            # this account's @username (used to find it from the other side)

E2E_EMAIL_2=
E2E_PASSWORD_2=
E2E_USERNAME_2=

# A movie that reliably exists in TMDB, used by search/list/review specs.
# Default: Inception (tmdb_id 27205).
E2E_MOVIE_QUERY=Inception
E2E_MOVIE_TMDB_ID=27205

# Optional: skip specs that write data to a shared/prod backend.
# Set to "1" to run read-only specs (anon smoke + search) only.
E2E_READONLY=0
