# ─── Spark RIN — environment ───────────────────────────────────────────────
# Copy to `.env` and adjust. The demo/tests default to an in-memory SQLite DB
# so the whole flow runs with zero external dependencies.

NODE_ENV=development
PORT=3000

# ─── Database ──────────────────────────────────────────────────────────────
# DB_DRIVER=sqlite  -> file/in-memory SQLite (great for demo, tests, CI)
# DB_DRIVER=postgres -> the production target (see docker-compose.yml)
DB_DRIVER=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=rin
DB_PASSWORD=rin
DB_DATABASE=rin
# For sqlite: path to the file, or ":memory:" for ephemeral.
DB_SQLITE_PATH=./rin.sqlite
# Auto-create schema from entities. Fine for MVP/demo; use migrations in prod.
DB_SYNCHRONIZE=true

# ─── Tokens ────────────────────────────────────────────────────────────────
# Signing secret for Spark consumer + merchant access tokens (HS256).
JWT_SECRET=dev-only-change-me-in-production
CONSUMER_TOKEN_TTL=3600
MERCHANT_TOKEN_TTL=3600
# How long a pending identity request (the QR) stays valid, in seconds.
IDENTITY_REQUEST_TTL=300

# ─── Webhooks ──────────────────────────────────────────────────────────────
WEBHOOK_TIMEOUT_MS=5000
WEBHOOK_MAX_ATTEMPTS=5
